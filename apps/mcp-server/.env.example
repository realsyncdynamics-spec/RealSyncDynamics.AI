# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MCP
MCP_API_KEY_PREFIX=rsmcp_

# Serverseitiges Geheimnis für den Key-Hash (HMAC-SHA-256), mindestens 32 Zeichen.
# MUSS in der Edge Function mcp-api-key-manager identisch gesetzt sein —
# weicht eine Seite ab, validiert kein einziger Key.
# Erzeugen: openssl rand -hex 32
MCP_KEY_PEPPER=
