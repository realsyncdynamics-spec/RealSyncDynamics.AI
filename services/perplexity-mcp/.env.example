# Perplexity MCP Configuration
# Get your API key from https://www.perplexity.ai/

# Required: Perplexity API Key
# Format: pplx_... (see https://docs.perplexity.ai/)
PERPLEXITY_API_KEY=pplx_your_api_key_here

# Optional: Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Node.js Memory Limit
# NODE_OPTIONS=--max-old-space-size=512

# Optional: Log Format (json, text)
# LOG_FORMAT=json

# Docker/Compose: Traefik Domain
# TRAEFIK_HOST=mcp.realsyncdynamicsai.de

# Docker/Compose: Traefik Network Name
# TRAEFIK_NETWORK=proxy
