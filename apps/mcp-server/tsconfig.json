{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "outDir": "./dist",
    // rootDir liegt im Repo-Wurzelverzeichnis, weil packages/evidence-chain
    // mitkompiliert wird: die Hash-Chain-Verifizierung muss zeichengenau
    // dieselbe sein wie in der Edge Function und in der SPA — eine Kopie hier
    // würde irgendwann abweichen und still falsche Ergebnisse liefern.
    // Folge: die Ausgabe liegt unter dist/apps/mcp-server/src/ (siehe
    // package.json "main"/"start" und das Dockerfile).
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true
  },
  "include": ["src/**/*", "../../packages/evidence-chain/src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
