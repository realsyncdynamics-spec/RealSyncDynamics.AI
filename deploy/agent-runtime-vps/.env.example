# Host-local bind by default. Reverse proxy/DNS is a separate step.
AGENT_RUNTIME_HOST_BIND=127.0.0.1
AGENT_RUNTIME_HOST_PORT=8787
AGENT_RUNTIME_IMAGE_TAG=latest
