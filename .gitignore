# Ohne Schrägstrich, damit auch ein *Symlink* namens `node_modules` ignoriert
# wird. Mit `node_modules/` greift die Regel nur für Verzeichnisse — so landete
# in f757c70c ein zirkulärer Symlink (node_modules -> …/node_modules) im Repo,
# der jeden Checkout dieses Branches unbrauchbar machte.
node_modules
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
!.env.docker.example
/scans/
test-results/
playwright-report/
playwright/.cache/

# Agent-Skills (installiert via `npx skills add ...`) — pro-Maschine,
# nicht Teil des Produktcodes.
.agents/
.claude/skills/
.claude/worktrees/
skills-lock.json

# Ops-Skripte: lokal generierte Drift-Vorschläge — projekt- und zeitabhängig,
# nicht commitbar (enthält evtl. Migration-IDs aus Live-Drift).
scripts/ops/.migration-drift-suggested.sh

# Agent-Worktrees (isolierte Subagent-Checkouts) — lokal, nicht commitbar.
.claude/worktrees/

# Privates Schlüsselmaterial gehört nie ins Repo.
*.key
*.pem
*.p12
*.pfx
# Öffentliche Schlüssel sind unkritisch (z. B. tools/realsync-cli/data/demo.pub.pem).
!*.pub.pem

# Lokaler wrangler-/Miniflare-Zustand (z. B. D1 unter --local) — nie ins Repo.
.wrangler/

# Bundle des Playwright-Scanners (wird in CI und im Docker-Build erzeugt)
deploy/playwright-scanner/server.js
