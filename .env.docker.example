# .env.docker — Docker Compose Environment Variables
# This file is used by docker-compose.yml for VPS deployment.
# Copy to .env on VPS and fill in real values.
# NEVER commit this file with secrets to git!

# ──────────────────────────────────────────────────────────────────────────
# GENERAL
# ──────────────────────────────────────────────────────────────────────────
DOMAIN=realsyncdynamicsai.de
COMPOSE_PROJECT_NAME=realsync

# ──────────────────────────────────────────────────────────────────────────
# FRONTEND (React/Vite)
# ──────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_SENTRY_DSN=""
VITE_GOOGLE_GENAI_API_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_AZURE_ENABLED=true
VITE_AUTH_GITHUB_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────
# TRAEFIK
# ──────────────────────────────────────────────────────────────────────────
# ACME certificate email (Let's Encrypt)
ACME_EMAIL="admin@realsyncdynamicsai.de"

# Traefik Dashboard basic auth (generate with: htpasswd -c temp username password)
# Format: username:$2a$10$... (bcrypt hash)
TRAEFIK_BASICAUTH_USERS="admin:$$2y$$05$$mY5Bz.AZX9lJzJf.Y7uC5uNjsQ1D3b5N4J.kQ5D5V5Z5V5ZV5Z5Z"
TRAEFIK_DASHBOARD_HOST="traefik.realsyncdynamicsai.de"

# Cloudflare API (optional, for wildcard certificates via DNS challenge)
CLOUDFLARE_API_TOKEN=""

# ──────────────────────────────────────────────────────────────────────────
# OLLAMA (Local LLM)
# ──────────────────────────────────────────────────────────────────────────
# Models to auto-pull: gemma2 (9B, recommended), mistral (7B), llama2 (7B, 13B, 70B)
OLLAMA_MODEL_PREF=gemma2

# ──────────────────────────────────────────────────────────────────────────
# HERMES (n8n Workflow Automation)
# ──────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY="your-random-encryption-key-32-chars"

# ──────────────────────────────────────────────────────────────────────────
# ANYTHINGLLM (RAG System)
# ──────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="your-random-jwt-secret-32-chars"

# ──────────────────────────────────────────────────────────────────────────
# WATCHTOWER (Auto-Update Images)
# ──────────────────────────────────────────────────────────────────────────
# Email notifications for watchtower
WATCHTOWER_EMAIL_TO="admin@realsyncdynamicsai.de"
WATCHTOWER_EMAIL_FROM="watchtower@realsyncdynamicsai.de"
WATCHTOWER_EMAIL_SERVER="smtp.gmail.com"
WATCHTOWER_EMAIL_SERVER_PORT=587
WATCHTOWER_EMAIL_USER="your-email@gmail.com"
WATCHTOWER_EMAIL_PASSWORD="your-app-password"

# ──────────────────────────────────────────────────────────────────────────
# BACKUPS & DISASTER RECOVERY
# ──────────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM UTC

# S3 for backup storage (optional)
# S3_BUCKET=realsync-backups
# S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ──────────────────────────────────────────────────────────────────────────
# MONITORING & OBSERVABILITY
# ──────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=""  # Backend error tracking

# ──────────────────────────────────────────────────────────────────────────
# STRIPE (Billing)
# ──────────────────────────────────────────────────────────────────────────
# Server-only keys (never in frontend)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ──────────────────────────────────────────────────────────────────────────
# GITHUB ACTIONS DEPLOYMENT
# ──────────────────────────────────────────────────────────────────────────
# VPS connection details
SSH_HOST=72.61.89.191
SSH_USER=deploy
SSH_KEY_PATH=/home/deploy/.ssh/id_ed25519
DEPLOY_PATH=/opt/realsyncdynamics
