{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/file-guard.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(supabase db push*)",
      "Bash(supabase migration up*)",
      "Bash(wrangler deploy*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Read(.archive/**)",
      "Read(**/*.sql.bak)",
      "Read(**/*.bak)",
      "Read(node_modules/**)",
      "Read(dist/**)",
      "Read(package-lock.json)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/*.generated.ts)",
      "Read(coverage/**)",
      "Read(playwright-report/**)",
      "Read(test-results/**)"
    ]
  }
}
