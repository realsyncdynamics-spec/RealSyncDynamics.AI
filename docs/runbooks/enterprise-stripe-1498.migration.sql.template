-- Enterprise Self-Service: Live Stripe Price 1.498 €/Monat netto
--
-- Vorlage, keine Migration. Siehe docs/runbooks/enterprise-stripe-1498.md.
-- Abhängig von #1982 (SSoT purchaseMode=checkout, endliche Quotas).
-- Aktuelle Enterprise-Price (1.249 €, netto/exclusive seit 20261020130000):
--   price_1USabSREjTWueUcGzUEzTaie (davor price_1TxLdLREjTWueUcGRaXie8Vs)
-- Neuer Price muss in Stripe existieren BEVOR diese Migration deployed wird:
--   unit_amount=149800, currency=eur, interval=month, interval_count=1,
--   tax_behavior=exclusive, active=true, livemode=true.
--
-- BLOCKER: price_REPLACE_ME und ggf. Product-ID in price-match.ts ersetzen.
-- Solange der Platzhalter steht, bricht der DO-Block absichtlich ab.

DO $$
BEGIN
  IF 'price_REPLACE_ME' NOT LIKE 'price_%'
     OR 'price_REPLACE_ME' = 'price_REPLACE_ME' THEN
    RAISE EXCEPTION
      'Enterprise Stripe Price nicht verdrahtet: price_REPLACE_ME in '
      'der Enterprise-Stripe-Migration durch die verifizierte '
      'Live-Price-ID (149800 Cent, exclusive) ersetzen. Siehe '
      'docs/runbooks/enterprise-stripe-1498.md.'
      USING ERRCODE = 'P0001';
  END IF;
END $$;

-- Default von enterprise lösen (alte 1.249-€-Zeile und Sentinels)
UPDATE public.products
   SET default_for_plan_key = NULL
 WHERE default_for_plan_key = 'enterprise'
   AND stripe_price_id IS DISTINCT FROM 'price_REPLACE_ME';

INSERT INTO public.products (stripe_price_id, name, default_for_plan_key)
VALUES (
  'price_REPLACE_ME',
  'Enterprise (1.498 €/Monat netto · Self-Service)',
  'enterprise'
)
ON CONFLICT (stripe_price_id) DO UPDATE
  SET name = EXCLUDED.name,
      default_for_plan_key = EXCLUDED.default_for_plan_key;

-- Zielzustand: genau eine Default-Zeile für enterprise mit der neuen Price-ID
DO $$
DECLARE
  n int;
  pid text;
BEGIN
  SELECT count(*), max(stripe_price_id)
    INTO n, pid
    FROM public.products
   WHERE default_for_plan_key = 'enterprise';

  IF n <> 1 OR pid IS DISTINCT FROM 'price_REPLACE_ME' THEN
    RAISE EXCEPTION
      'Enterprise products default_for_plan_key inkonsistent: count=%, id=% (erwartet 1 × price_REPLACE_ME)',
      n, pid
      USING ERRCODE = 'P0001';
  END IF;
END $$;
