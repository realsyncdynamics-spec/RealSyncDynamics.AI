{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    // Der geteilte Kern importiert Typen aus 'playwright'; hier sind es die
    // Typen der tatsächlich gebündelten Bibliothek (Cloudflare-Fork).
    "baseUrl": ".",
    "paths": { "playwright": ["./node_modules/@cloudflare/playwright"] }
  },
  "include": ["src/**/*.ts", "../../deploy/playwright-scanner/session-core.ts", "../../deploy/playwright-scanner/netguard.ts"]
}
