# Kopie als .env anlegen — .env gehört NICHT ins Repo.

# --- Authentifizierung -------------------------------------------------------
# Format: "token:mandanten-uuid,token2:mandanten-uuid".
# LEER = Auth ist AUS. Dann gilt der Default-Mandant und jeder Endpoint ist
# offen — nur fuer lokale Entwicklung. /health meldet den Zustand.
# Der Token bestimmt den Mandanten; ein Client kann ihn beweisen, nicht waehlen.
# BUILDER_AUTH_TOKENS=tok_kunde_a:11111111-1111-1111-1111-111111111111
# GOVERNANCE_AUTH_TOKENS=tok_kunde_a:11111111-1111-1111-1111-111111111111

# Dienst-zu-Dienst: Der Orchestrator ruft das Governance-Backend im Hintergrund
# auf, lange nach der HTTP-Anfrage. Nur mit diesem Token darf ein Aufrufer den
# Mandanten per X-Tenant-Id behaupten. Beide Werte muessen gleich sein.
# GOVERNANCE_SERVICE_TOKEN=tok_service_geheim

# Mandant, wenn Auth aus ist.
BUILDER_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
GOVERNANCE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- Gemeinsam ---------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- Builder Orchestrator ----------------------------------------------------
GOVERNANCE_BASE_URL=http://governance_backend:8002
GOVERNANCE_TIMEOUT_SECONDS=10

# --- Governance Backend ------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@supabase_db:5432/postgres

# Incident-Dispatch an n8n. Leer = Befunde entstehen trotzdem, sind aber nur
# über GET /api/v1/governance/incidents sichtbar.
# GOVERNANCE_WEBHOOK_URL=http://n8n:5678/webhook/governance-incidents
GOVERNANCE_WEBHOOK_TIMEOUT=5
# Wiederholung gescheiterter Zustellungen
GOVERNANCE_REDELIVERY_INTERVAL=60
GOVERNANCE_DISPATCH_MAX_ATTEMPTS=5
GOVERNANCE_DISPATCH_RETRY_BASE=60

# --- Observability -----------------------------------------------------------
# Leer lassen => Spans gehen auf stdout (Console-Exporter).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_BUILDER_URL=http://builder.localhost
NEXT_PUBLIC_GOVERNANCE_URL=http://rsd.localhost

# --- LLM-Provider ------------------------------------------------------------
# Auswahl in dieser Reihenfolge: LLM_PROVIDER (falls gesetzt) -> Claude (Key
# vorhanden) -> Ollama (URL vorhanden) -> Stub. Ohne alles antwortet der
# Stub-Provider deterministisch; der Stack laeuft dann ohne Zugangsdaten.
# LLM_PROVIDER=            # anthropic | ollama | stub — leer = Auto-Erkennung

# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# EU-lokale Alternative ohne US-Anbieter.
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3

LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
# Zusaetzliche Versuche, wenn die Antwort das Schema verletzt. Bewusst klein:
# jede Runde kostet einen vollen Modellaufruf.
LLM_MAX_REPAIRS=1

# --- Build & Workspace -------------------------------------------------------
# Hier liegen die generierten Dateien. Fuer echte Builds auf ein Volume legen.
BUILDER_WORKSPACE_ROOT=/tmp/builder_workspaces
BUILDER_MAX_FILES_PER_MODULE=200
BUILDER_MAX_FILE_BYTES=524288

# Kommando fuer den Testnachweis, ausgefuehrt im Projektverzeichnis. Leer =
# kein Nachweis => tests_passed bleibt false => das Gate blockiert. Das ist
# Absicht: ein Build ohne Testnachweis ist kein freigabefaehiger Build.
# BUILDER_TEST_COMMAND=npm test
BUILDER_TEST_TIMEOUT_SECONDS=300
