# Local-development env-template. Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# ──────────────── Required for the app to function ────────────────

# Supabase project URL (e.g. https://abcd1234.supabase.co)
VITE_SUPABASE_URL="MY_SUPABASE_URL"

# Supabase anon (public) key — safe to ship in the bundle
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# ──────────────── AI provider keys ────────────────

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ──────────────── Optional — OAuth-Provider-Buttons (Auth) ────────────────
#
# Sichtbarkeit der Social-Login-Buttons auf /welcome + Checkout
# (src/features/auth/OAuthProviderButtons.tsx). Steuert NUR die UI —
# die eigentliche Provider-Aktivierung passiert im Supabase-Dashboard
# (Authentication → Providers). Setup pro Provider: docs/oauth-setup.md
#
# Semantik:
#   • Default ist AN — nur der explizite Wert "false" blendet einen Button aus.
#     So zeigt ein frisch deployter Stack ohne gesetzte Var weiterhin alle
#     eingerichteten Provider. Zum Ausblenden eines (noch) defekten Providers
#     ohne Redeploy: Flag im Hosting-Dashboard auf "false" setzen.
#   • Ausnahme LinkedIn: opt-IN — der Button erscheint NUR bei explizitem
#     "true", weil `linkedin_oidc` im Supabase-Projekt erst aktiviert werden
#     muss (sonst liefe der Klick in „Unsupported provider").
VITE_AUTH_GOOGLE_ENABLED="true"
VITE_AUTH_AZURE_ENABLED="true"
VITE_AUTH_GITHUB_ENABLED="true"
VITE_AUTH_LINKEDIN_ENABLED="false"

# ──────────────── Optional — observability ────────────────

# VITE_SENTRY_DSN: Sentry project DSN for error tracking.
# When unset, sentry init is a no-op (see src/lib/sentry.ts).
# Setup walkthrough: docs/runbooks/sentry-setup.md
# Format: https://<key>@<id>.ingest.de.sentry.io/<project-id>  (EU region)
VITE_SENTRY_DSN=""

# ──────────────── Optional — Stripe Billing ────────────────
#
# WICHTIG — maßgebliche Price-ID-Quelle zur Laufzeit ist die DATENBANK:
#   Die Edge-Function `stripe-checkout` löst die Stripe-Price-ID
#   ausschließlich aus `public.products.stripe_price_id`
#   (`default_for_plan_key`-Match) auf und verwirft Sentinel-Werte
#   (`internal_default_*`). Echte `price_…`-IDs werden per SQL geseedet:
#   siehe docs/runbooks/stripe-production-checkout.md
#   und docs/stripe-pricing-seed.template.sql.
#
# Die folgenden Frontend-Variablen sind die optionale, build-injizierte
# Convenience-Quelle (src/core/billing/stripe-mapping.ts) für UI-Zwecke und
# werden NICHT vom Checkout-Flow zur Preisermittlung gelesen. Beim Build von
# CI gesetzt (.github/workflows/deploy-cloudflare-pages.yml). Format je:
# "price_…" (Stripe → Products → <Tier> → Price ID).
VITE_STRIPE_PRICE_STARTER=""
VITE_STRIPE_PRICE_GROWTH=""
VITE_STRIPE_PRICE_AGENCY=""
VITE_STRIPE_PRICE_STARTER_YEARLY=""
VITE_STRIPE_PRICE_GROWTH_YEARLY=""
VITE_STRIPE_PRICE_AGENCY_YEARLY=""

# ──────────────── Optional — weitere öffentliche Frontend-Werte ────────────────
# Alle hier landen im Bundle (nur Publishable Keys / IDs). Beim Build in CI aus
# gleichnamigen Repo-Secrets gesetzt (.github/workflows/deploy-cloudflare-pages.yml).
# Leer = Feature aus.
VITE_SUPABASE_ANON_JWT=""          # Legacy-Anon-JWT (eyJ…) — Audit-Copilot → AI-Gateway
VITE_TURNSTILE_SITE_KEY=""         # Cloudflare Turnstile Site Key (0x4AAA…) — Bot-Schutz
VITE_STRIPE_MODE="test"            # Beta: "test" (Default) | "live" — siehe docs/STRIPE_SANDBOX_SETUP.md
VITE_STRIPE_PUBLISHABLE_KEY=""     # pk_test_… im Testmodus (pk_live_… wird dann verworfen)
VITE_STRIPE_AUDIT_PRO_LINK=""      # https://buy.stripe.com/… (Fallback: /checkout/growth)
VITE_STRIPE_CONNECT_ID=""          # ca_… (Stripe Connect OAuth, Integrationen)
VITE_GOOGLE_OAUTH_ID=""            # Google OAuth Client-ID (Integrationen)
VITE_SENTRY_TRACES_SAMPLE_RATE=""  # z. B. 0.1
VITE_MARKETING_ANALYTICS_ENABLED="" # "1" erzwingt Marketing-Analytics
VITE_GOOGLE_ADS_ID=""              # AW-XXXXXXXXX
VITE_GOOGLE_ADS_LABEL_LEAD=""
VITE_GOOGLE_ADS_LABEL_TRIAL=""
VITE_GOOGLE_ADS_LABEL_PURCHASE=""
VITE_LINKEDIN_CONVERSION_LEAD=""   # numerische LinkedIn Conversion-ID
VITE_LINKEDIN_CONVERSION_TRIAL=""
VITE_LINKEDIN_CONVERSION_PURCHASE=""

# ──────────────── Server-only — Edge-Function-Secrets (nur Namen) ────────────────
# `supabase secrets set NAME=…` (GROSS geschrieben — Deno.env ist case-sensitiv).
# Einige Functions fallen auf Vault (`get_app_secret`, klein geschrieben) zurück.
#   E-Mail:     RESEND_API_KEY (re_…), RESEND_FROM
#   AI:         ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY
#   Cron:       CRON_SCHEDULER_DISPATCH_KEY, CRON_MEMORY_DECAY_KEY,
#               CRON_GOVERNANCE_MONITORING_KEY — Wert == gleichnamiger Vault-Eintrag
#               (klein), siehe docs/runbooks/cron-vault-secrets.md
#   Webhooks:   TELEGRAM_WEBHOOK_SECRET, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN
#   Signaturen: PROVENANCE_ED25519_PRIVATE_KEY, EVIDENCE_VAULT_SIGNING_KEY

# ──────────────── Server-only — Stripe Secrets (Edge Functions) ────────────────
# NUR in Supabase Edge-Function-Secrets / VPS-Env setzen — NIEMALS im Frontend
# (kein VITE_-Prefix → landet nicht im Bundle). Edge-Functions lesen primär
# Deno.env und fallen sonst auf `vault.secrets` zurück (get_app_secret RPC).
#   STRIPE_SECRET_KEY:     sk_live_… / sk_test_…  (stripe-checkout, stripe-portal)
#   STRIPE_WEBHOOK_SECRET: whsec_…               (stripe-webhook Signaturprüfung)
# Beta-Testmodus (supabase/functions/_shared/stripe-mode.ts, docs/STRIPE_SANDBOX_SETUP.md):
#   STRIPE_MODE:                 test (Default) | live — nur exakt "live" schaltet Live frei
#   STRIPE_SECRET_KEY_TEST:      sk_test_…  (Live-Key wird im Testmodus abgewiesen)
#   STRIPE_WEBHOOK_SECRET_TEST:  whsec_…    (Testmodus-Webhook-Endpoint)
#   STRIPE_TEST_PRICE_<PLAN_KEY>: price_…   z. B. STRIPE_TEST_PRICE_STARTER
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ──────────────── Optional — Hostinger MCP-Server (lokale Dev-Tools) ────────────────
#
# Wird ausschließlich von den MCP-Servern in `.mcp.json` gelesen (Claude Code
# expandiert `${HOSTINGER_API_TOKEN}` beim Server-Start). Kein VITE_-Prefix →
# landet NICHT im Frontend-Bundle und wird von der App zur Laufzeit nicht genutzt.
#
# Token erzeugen: hPanel → Account → API → "Generate new token".
# Scope so eng wie möglich wählen — der Token kann Hosting, DNS, VPS, Domains,
# Billing und Reach schreibend verändern. Setup + Server-Übersicht:
# docs/integrations/hostinger-mcp.md
# HOSTINGER_API_TOKEN="..."
