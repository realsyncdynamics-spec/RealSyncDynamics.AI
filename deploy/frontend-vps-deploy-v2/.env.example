# frontend-vps-deploy-v2 — .env.example
#
# Diese Datei ist ein Template. Auf dem VPS nach .env kopieren und mit echten Werten befüllen.
# NICHT in Git committen!
#
# Alle Werte außer VITE_SENTRY_DSN und SLACK_WEBHOOK_URL sind erforderlich.

# ── Build-Zeit (Vite ENV) ──────────────────────────────────────────────────────
# Diese Werte werden beim Docker-Build in den SPA-Bundle gebacken.
# Aus GitHub Secrets referenzieren.
VITE_SUPABASE_URL="${VITE_SUPABASE_URL}"
VITE_SUPABASE_ANON_KEY="${VITE_SUPABASE_ANON_KEY}"

# Optional — Sentry DSN für Error-Tracking
VITE_SENTRY_DSN="${VITE_SENTRY_DSN}"

# ── Runtime / Docker Compose ───────────────────────────────────────────────────
# Host-Bind-Adresse. Default 127.0.0.1 = nur lokal auf dem VPS erreichbar.
# Ändere auf "0.0.0.0" nur dann, wenn ein Reverse-Proxy (Traefik/nginx) davor steht.
FRONTEND_HOST_BIND=127.0.0.1

# Host-Port. Default 8090.
# NICHT 8080 verwenden — das ist für andere Services reserviert.
FRONTEND_HOST_PORT=8090

# Image-Tag für Rollback-Strategien (z.B. git-sha, release-version, latest)
FRONTEND_IMAGE_TAG=latest

# ── Logging ────────────────────────────────────────────────────────────────────
# JSON-File-Driver mit automatischer Rotation (10 MB × 3)
# Kein zusätzliches Aufräumen nötig.
COMPOSE_PROJECT_NAME=realsync
