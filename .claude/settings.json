{
  "permissions": {
    "deny": [
      "Read(./package-lock.json)",
      "Read(./**/package-lock.json)",
      "Read(./**/*.generated.ts)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./playwright-report/**)",
      "Read(./test-results/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
