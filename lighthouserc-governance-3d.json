{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4173/design/governance-3d"
      ],
      "numberOfRuns": 2,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.55
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.7
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.25
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 5500
          }
        ],
        "errors-in-console": [
          "warn",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
