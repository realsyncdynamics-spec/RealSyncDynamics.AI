{
  // GOVARD Gateway — Governance-/Evidence-Schicht vor austauschbaren Agenten.
  //
  // Ein Command (n8n, OpenAI, Claude, Zapier, UI, API) läuft immer über
  // POST /api/command: Policy-Evaluation (deny by default), Command State
  // Machine, Approval Inbox, Evidence-Chain (Durable Object pro Org,
  // D1-Projektion, tägliches R2-Siegel). Architektur: README.md.
  //
  // Provisionierung (einmalig, siehe README):
  //   npx wrangler d1 create govard-gateway --jurisdiction eu
  //     -> database_id unten eintragen (Platzhalter ersetzen)
  //   npx wrangler r2 bucket create govard-evidence-seals --jurisdiction eu
  //   npx wrangler d1 migrations apply govard-gateway --remote \
  //     --config workers/govard-gateway/wrangler.jsonc
  //
  // Die Jurisdiktion ist bei BEIDEN nur beim Anlegen setzbar. Wird sie
  // vergessen, liegen Commands und Evidence ausserhalb der EU-Bindung —
  // das widerspricht dem Kernversprechen des Produkts und laesst sich nur
  // durch Neuanlegen heilen. Die D1-Bindung hat kein jurisdiction-Feld
  // (die database_id adressiert die Datenbank bereits eindeutig), die
  // R2-Bindung braucht es dagegen zwingend — siehe unten.
  //
  // Der Deploy-Workflow (.github/workflows/deploy-govard-gateway.yml)
  // überspringt sich selbst, solange der Platzhalter unten steht — gleiches
  // Guard-Muster wie workers/siteos-preview.
  //
  // Secrets stehen NICHT hier. API-Keys leben ausschließlich als SHA-256-
  // Hashes in der Tabelle api_keys (Seeding: README).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "govard-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "govard-gateway",
      "database_id": "PLACEHOLDER_SET_VIA_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "EVIDENCE", "class_name": "EvidenceSequencer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EvidenceSequencer"] }
  ],

  // Durable Ausfuehrung freigegebener Commands. Anders als Durable Objects
  // brauchen Workflows KEINEN migrations-Eintrag — die Klasse wird allein
  // ueber class_name gebunden (an der Cloudflare-Dokumentation geprueft).
  //
  // Warum ueberhaupt ein Workflow: ctx.waitUntil endet mit der
  // Worker-Instanz. Stirbt sie waehrend eines LLM-, Stripe- oder
  // Mail-Aufrufs, bliebe der Command fuer immer in EXECUTING und die
  // Evidence-Kette ohne Ergebnis. Ein Workflow nimmt an der letzten
  // abgeschlossenen Stufe wieder auf.
  "workflows": [
    {
      "name": "govard-command",
      "binding": "COMMAND_WORKFLOW",
      "class_name": "CommandWorkflow"
    }
  ],

  // "jurisdiction": "eu" haelt die Siegel der Evidence-Chain in der EU.
  // Sie wird beim Anlegen mitgegeben (`--jurisdiction eu`) und ist danach
  // NICHT mehr aenderbar. Die Bindung muss sie wiederholen: ohne diese Zeile
  // sucht der Worker in der Standard-Jurisdiktion und findet den Bucket nicht.
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "govard-evidence-seals",
      "jurisdiction": "eu"
    }
  ],

  // Tägliches Siegel des Chain-Heads + Verfall offener Freigaben.
  "triggers": { "crons": ["30 3 * * *"] },

  "vars": {
    // Kommagetrennt; leer = kein CORS. Für die Approval Inbox im SPA.
    "ALLOWED_ORIGINS": "https://realsyncdynamicsai.de,https://www.realsyncdynamicsai.de"
  },

  "observability": { "enabled": true }
}
