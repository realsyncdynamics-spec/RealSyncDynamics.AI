# Claude Code — do not index / glob these paths.
# Without this file every Cloud session walks the monorepo and burns tokens.

# deps + build
node_modules/
**/node_modules/
dist/
**/dist/
build/
.next/
.turbo/
coverage/
playwright-report/
test-results/
*.map
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock
pnpm-lock.yaml
**/pnpm-lock.yaml

# generated — accidental Read empties the window
**/*.generated.ts

# archives + bak (root is full of .sql.bak)
.archive/
.archive/**
*.bak
*.sql.bak
AUDIT/
AUDIT/**

# heavy trees — open explicitly when needed
docs/
docs/**
platform/
platform/**
services/
services/**
apps/
apps/**
supabase/migrations/
supabase/functions/**/node_modules/

# media + dumps
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.webm
*.pdf
*.zip
*.tar
*.gz
*.woff
*.woff2
*.ttf

# local / secrets
.env
.env.*
!.env.example
.wrangler/
.vercel/

# git / ci noise
.git/
.github/workflows/
