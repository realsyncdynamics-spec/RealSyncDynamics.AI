/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # Cloudflare Pages injiziert das Web-Analytics-Beacon selbst; ohne
  # static.cloudflareinsights.com in script-src (Skript) und
  # cloudflareinsights.com in connect-src (Messwert-POST) wurde es bei
  # JEDEM Seitenaufruf blockiert — gemessen am 2026-08-30, zusammen mit
  # dem 500er von track-pageview waren damit beide Analytics-Wege stumm.
  # Nach der eigenen Tracker-Registry (_shared/rules/tracker-registry.json,
  # id: cloudflare_web_analytics) ist das Beacon cookieless und
  # einwilligungsfrei (Art. 6 Abs. 1 lit. f). Die Registry verlangt aber
  # zweierlei: Nennung in der Datenschutzerklaerung und einen AVV wegen
  # des US-Transfers. Beides steht noch aus — siehe docs/qa/produktions-akzeptanz.md.
  #
  # 2026-09-18 CSP-Haertung:
  # - frame-src explizit (kein Erbe von default-src auf beliebige *.supabase.co)
  # - default-src ohne Supabase; connect-src nur Projekt ebljyceifhnlzhjfyxup
  # - script-src ohne 'unsafe-inline' (SPA-Bundle ist src=; Nonce braucht Edge)
  # - Marketing-Hosts bleiben, weil pixels.ts sie erst nach Consent injiziert.
  #   Ohne Host in der CSP waere Consent-Load ein stiller Fehlschlag.
  Content-Security-Policy: default-src 'self' data:; script-src 'self' https://static.cloudflareinsights.com https://connect.facebook.net https://www.googletagmanager.com https://www.google-analytics.com https://analytics.tiktok.com https://snap.licdn.com https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://ebljyceifhnlzhjfyxup.supabase.co wss://ebljyceifhnlzhjfyxup.supabase.co https://*.ingest.de.sentry.io https://*.ingest.sentry.io https://www.facebook.com https://www.google-analytics.com https://analytics.tiktok.com https://*.tiktok.com https://px.ads.linkedin.com https://api.stripe.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  # HTML nie im Browser-Cache halten. Die Regel stand vorher unter
  # /index.html und griff dadurch nie: Cloudflare Pages matcht gegen den
  # Request-Pfad, und der ist "/" bzw. "/pricing" — nie "/index.html".
  # Folge war bis zu 1 h altes HTML und damit ein altes JS-Bundle nach
  # jedem Deploy. s-maxage bleibt hoch, der Edge-Cache wird beim Deploy
  # ohnehin invalidiert.
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Bilder tragen keinen Hash im Namen, deshalb kein "immutable" — aber eine
# Woche Browser-Cache. Bei einem Motivwechsel genuegt ein neuer Dateiname.
/*.webp
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/api/*
  Cache-Control: private, max-age=0, no-cache

/governance/*
  Cache-Control: public, max-age=300, s-maxage=3600

/audit/*
  Cache-Control: public, max-age=60, s-maxage=600
