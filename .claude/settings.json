{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Read(.archive/**)",
      "Read(**/*.sql.bak)",
      "Read(**/*.bak)",
      "Read(node_modules/**)",
      "Read(dist/**)"
    ]
  }
}
