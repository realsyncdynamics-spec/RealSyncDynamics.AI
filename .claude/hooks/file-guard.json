{
  "_hinweis": "Technische Änderungskontrolle für Agenten (REA, RENDER). Gelesen von .claude/hooks/file-guard.mjs als PreToolUse-Hook für Edit/Write/MultiEdit/NotebookEdit. deny gewinnt immer vor allow. Liegt ein Pfad im Repo und passt auf kein allow-Muster, wird er blockiert. Lockern nur mit Freigabe von Dominik (CODEOWNERS).",
  "deny": [
    "supabase/**",
    ".github/**",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/hooks/**",
    ".mcp.json",
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "package.json",
    "**/package-lock.json",
    "wrangler*.toml",
    "shared/pricing.ts",
    "src/config/pricing.ts",
    "src/config/beta.ts",
    "**/*.generated.ts",
    "src/lib/supabase.ts",
    "src/lib/supabaseUrl.ts",
    "src/lib/stripe.ts",
    "src/lib/billing/**",
    "src/core/billing/**",
    "src/core/access/**",
    "src/core/runtime/supabase/**",
    "src/features/auth/**",
    "src/features/supabase/**",
    "src/features/billing/**",
    "src/features/admin/billing/**",
    "src/features/siteos/builderEntitlements.ts",
    "src/agents/stripe-business/**",
    "src/pages/integrations/StripeOAuthCallback.tsx",
    "src/product/implementation-status.ts",
    "src/pages/legal/**"
  ],
  "allow": [
    "src/**",
    "public/**",
    "test/**",
    "tests/**",
    "e2e/**",
    "docs/**",
    ".claude/agents/**",
    ".claude/skills/**",
    ".claude/commands/**"
  ]
}
